<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.android.systemui"/></queries>
    <application android:label="LiquidShade" android:description="@string/description" android:theme="@style/ShadeTheme" android:allowBackup="false" android:supportsRtl="true" android:icon="@drawable/ic_lens">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <provider android:name=".Bridge" android:authorities="dev.vadinyt.liquidshade.bridge" android:permission="android.permission.STATUS_BAR_SERVICE" android:exported="true" android:directBootAware="true" />
    </application>
</manifest>
